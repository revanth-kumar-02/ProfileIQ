PORT=3001
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
CLIENT_ORIGIN=http://localhost:3000

# ProfileIQ Extraction Provider Configuration
# Supported options: 'direct-linkedin', 'external-provider'
PROFILE_EXTRACTION_PROVIDER=direct-linkedin

# Optional External Data Provider API settings (for ExternalProfileProvider)
PROFILE_PROVIDER_API_KEY=
PROFILE_PROVIDER_BASE_URL=

# Optional Fallback Chain (comma-separated list of provider IDs)
PROFILE_PROVIDER_CHAIN=external-provider,direct-linkedin
